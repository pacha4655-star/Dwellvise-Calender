# OfficeFlow Environment Configuration
# Add your Supabase Project credentials below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key for server-side admin tasks (Do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_APP_NAME="OfficeFlow"
NEXT_PUBLIC_APP_DEFAULT_START="2026-10-01"
NEXT_PUBLIC_APP_MAX_END="2027-12-31"
